[% WRAPPER '_assets/master.html.tt'
    app_key = 'sevenink'
    page_title = '7ink.com.au dashboard'
    page_stylesheets = [
        'sevenink/sevenink.css'
    ]
    page_scripts = [
        'sevenink/sevenink.js'
    ]
    include_legacy_stylesheets = 0
    include_legacy_scripts = 0
    include_cjt = 0
-%]
[% SET CPANEL.CPVAR.dprefix = '../' %]

<div class="sevenink-page">
    <header class="sevenink-header">
        <p class="sevenink-eyebrow">Hosting Control</p>
        <h1>7ink.com.au</h1>
        <p>Welcome to your custom cPanel interface starter.</p>
    </header>

    <section class="sevenink-card">
        <h2>Next Steps</h2>
        <ol>
            <li>Update <code>dynamicui.conf</code> if you want a different sidebar group.</li>
            <li>Replace this content with your real tools and links.</li>
            <li>Keep <code>CPANEL.CPVAR.dprefix</code> set so menu/search navigation works.</li>
        </ol>
    </section>
</div>

[% END %]
