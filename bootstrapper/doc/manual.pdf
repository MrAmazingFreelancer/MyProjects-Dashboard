	// false
	// false
}

func ExampleContainsRune() {
	fmt.Println(bytes.ContainsRune([]byte("I like seafood."), 'f'))
	fmt.Println(bytes.ContainsRune([]byte("I like seafood."), 'Ã¶'))
	fmt.Println(bytes.ContainsRune([]byte("å»æ˜¯ä¼Ÿå¤§çš„!"), 'å¤§'))
	fmt.Println(bytes.ContainsRune([]byte("å»æ˜¯ä¼Ÿå¤§çš„!"), '!'))
	fmt.Println(bytes.ContainsRune([]byte(""), '@'))
